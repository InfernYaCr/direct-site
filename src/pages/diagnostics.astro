---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/sections/Footer.astro';
import CookieBanner from '@/components/ui/CookieBanner.astro';

const painPoints = [
  'Уже отдали 2–3 агентствам по 60–150 тысяч в месяц. Получили красивые отчёты с «кликами» и «охватами» — а в кассе пусто.',
  'Администратор говорит: «звонят не те, спрашивают только „удалить зуб бесплатно“».',
  'Хирурги-имплантологи сидят без работы, а лизинг за оборудование и аренду никто не отменял.',
  'Вечерами сами лезете в отчёты и считаете заявки в Excel — потому что доверять уже некому.',
  'Сарафан закончился, конкурент через дорогу демпингует «имплант за 19 900», а вы честно держите 45 000 — и проигрываете.',
  'Каждый новый маркетолог обещает «лиды по 300 рублей», а через месяц — снова кассовый разрыв.',
];

const leakPoints = [
  'Вы платите за клики людей, которые никогда не запишутся на имплантацию за 80 000 ₽.',
  'Кресла пустые, врачи без работы, лизинг капает.',
  'Через месяц агентство разводит руками: «ну, нужно ещё потестить связки».',
  'Вы из своего кармана финансируете обучение чужого алгоритма.',
];

const navigatorAssets = [
  {
    title: 'Проверенные предложения',
    body: 'Связки под имплантацию, виниры, All-on-4 и ортодонтию.',
  },
  {
    title: 'Платёжеспособные аудитории',
    body: 'Люди, которые уже платили за дорогое лечение.',
  },
  {
    title: 'Медицинская модерация',
    body: 'Креативы, которые легче проходят строгие правила площадок.',
  },
  {
    title: '200+ минус-фраз',
    body: 'Отсекаем «бесплатно», «дёшево», «по акции» и похожие запросы.',
  },
];

const comparisons = [
  ['3–4 недели обучения за ваш счёт', 'Заявки уже на 3–5 день'],
  ['Случайный трафик «всем подряд»', 'Только платёжеспособные пациенты'],
  ['Заявки «на бесплатное удаление»', 'Имплантация, виниры, All-on-4'],
  ['CAC 8 000–15 000 ₽', 'CAC до 4 000 ₽ за запись'],
  ['«Дайте ещё месяц на тесты»', '30–50 пациентов в месяц по прогнозу'],
];

const auditSteps = [
  {
    time: '5 мин',
    title: 'Смотрим ваш кабинет',
    body: 'Открываете доступ к Я.Директ или ВК. Я смотрю кампании, бюджеты, ставки и аудитории.',
  },
  {
    time: '10 мин',
    title: 'Показываю, где утекают деньги',
    body: 'Конкретно по пунктам: где крутятся нецелевые запросы, где нет минус-фраз, где аудитория не похожа на пациентов с чеком.',
  },
  {
    time: '8 мин',
    title: 'Считаем экономику рекламы',
    body: 'Сколько сейчас стоит пациент, сколько он должен стоить по рынку и сколько денег вы теряете в месяц.',
  },
  {
    time: '7 мин',
    title: 'План «Умного Навигатора»',
    body: 'Какие готовые связки подходят под вашу клинику и за сколько дней можно выйти на стабильный поток.',
  },
];

const diagnosticResults = [
  'Полный разбор текущего рекламного кабинета.',
  'Цифры: сколько вы переплачиваете за пациента.',
  'Понимание, реально ли выйти на 30–50 записей в месяц.',
  'План внедрения метода «Умный Навигатор» под вашу клинику.',
];

const photoSlots = [
  'Hero: фото Ростислава в клинике или светлый кабинет стоматологии.',
  'Problem: скрин рекламного кабинета с замазанными данными и пометками.',
  'Author: портрет Ростислава, лучше в деловом casual или на фоне рабочего места.',
  'Bonus/CTA: фото созвона, ноутбука с рекламным кабинетом или мини-аудита.',
];
---

<Base
  title="30-минутная диагностика рекламы для стоматологий"
  description="Светлый лендинг диагностики рекламного кабинета ВК и Яндекс.Директ для владельцев стоматологических клиник."
>
  <main id="main-content" class="diagnostics-page">
    <section class="diag-hero" aria-labelledby="diag-hero-heading">
      <div class="diag-hero__media" aria-hidden="true">
        <div class="diag-photo diag-photo--hero">
          <span>Фото: Ростислав или стоматологический кабинет</span>
        </div>
      </div>

      <div class="container diag-hero__inner">
        <div class="diag-hero__copy">
          <p class="diag-kicker">30-минутная диагностика для владельцев стоматологий</p>
          <h1 id="diag-hero-heading">
            Сливаете 100 000 ₽/мес на рекламу, а в кресле пусто?
          </h1>
          <p>
            За 30 минут покажу, где утекают деньги — и как получать 30–50 платёжеспособных пациентов в месяц на имплантацию по цене до 1 500 ₽ за запись.
          </p>
          <div class="diag-hero__actions">
            <a class="diag-button" href="#diag-cta">Записаться на диагностику</a>
            <span>Без новых тестов, без слива бюджета на «обучение алгоритма».</span>
          </div>
        </div>

        <div class="diag-hero__metrics" aria-label="Ключевые цифры">
          <article>
            <strong>0 ₽</strong>
            <span>для владельцев стоматологий до конца месяца</span>
          </article>
          <article>
            <strong>3–5 день</strong>
            <span>первые заявки после запуска связок</span>
          </article>
          <article>
            <strong>200+</strong>
            <span>минус-фраз против дешёвых запросов</span>
          </article>
        </div>
      </div>
    </section>

    <section class="diag-section diag-pain" aria-labelledby="diag-pain-heading">
      <div class="container diag-split">
        <div class="diag-section__lead">
          <p class="diag-kicker">Если вы владелец клиники</p>
          <h2 id="diag-pain-heading">Вам это знакомо</h2>
          <p>Главное ощущение — вы не понимаете, кому ещё можно верить.</p>
        </div>

        <div class="diag-pain__list">
          {painPoints.map((point, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{point}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="diag-section diag-problem" aria-labelledby="diag-problem-heading">
      <div class="container diag-problem__inner">
        <div class="diag-problem__copy">
          <p class="diag-kicker">Почему так происходит</p>
          <h2 id="diag-problem-heading">Реклама не умерла. Алгоритм просто ищет вслепую за ваш счёт</h2>
          <p>
            Каждое агентство запускает кабинет «с чистого листа» и первые 3–4 недели сливает ваш бюджет на то, чтобы алгоритм Яндекса или ВК научился искать пациентов.
          </p>
          <p>
            В это время нейросеть показывает рекламу всем подряд: школьникам, пенсионерам, людям с запросами «бесплатное удаление» и «акция за 19 900».
          </p>
        </div>

        <figure class="diag-proof">
          <div class="diag-photo diag-photo--dashboard">
            <span>Фото/скрин: рекламный кабинет с пометками аудита</span>
          </div>
          <figcaption>Место под реальный скрин кабинета с замазанными данными: ставки, запросы, расход, проблемные аудитории.</figcaption>
        </figure>
      </div>

      <div class="container diag-leaks">
        {leakPoints.map((point) => (
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v10" />
              <path d="M12 17h.01" />
              <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <p>{point}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="diag-section diag-method" aria-labelledby="diag-method-heading">
      <div class="container">
        <div class="diag-section__lead diag-section__lead--wide">
          <p class="diag-kicker">Решение</p>
          <h2 id="diag-method-heading">«Умный Навигатор» убирает фазу обучения</h2>
          <p>
            За 6 лет работы в маркетинге и 10+ проектов в медицине накопилась готовая обученная экосистема. Когда мы запускаем вашу клинику, я не начинаю с нуля: загружаю в кабинет готовые «данные-доноры», и алгоритм быстрее переходит в рабочий режим.
          </p>
        </div>

        <div class="diag-method__grid">
          {navigatorAssets.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="diag-section diag-compare" aria-labelledby="diag-compare-heading">
      <div class="container">
        <div class="diag-section__lead diag-section__lead--wide">
          <p class="diag-kicker">Сравнение</p>
          <h2 id="diag-compare-heading">Что меняется после запуска по методу</h2>
        </div>

        <div class="diag-compare__table">
          <div class="diag-compare__head">
            <span>Стандартное агентство</span>
            <span>Умный Навигатор</span>
          </div>
          {comparisons.map(([before, after]) => (
            <article>
              <p>{before}</p>
              <p>{after}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="diag-section diag-author" aria-labelledby="diag-author-heading">
      <div class="container diag-author__inner">
        <figure>
          <div class="diag-photo diag-photo--portrait">
            <span>Фото: портрет Ростислава Загребина</span>
          </div>
          <figcaption>Лучше использовать реальный портрет, не сток: доверие в медицинской нише держится на личности специалиста.</figcaption>
        </figure>

        <div class="diag-author__copy">
          <p class="diag-kicker">Кто проводит диагностику</p>
          <h2 id="diag-author-heading">Ростислав Загребин</h2>
          <p>
            6 лет в маркетинге, фокус — Яндекс.Директ и ВК для медицины. На первом клиенте сделал х10 по чистой прибыли за 1,5 года через Я.Директ и сайт.
          </p>
          <ul>
            <li>10+ проектов в медицине и стоматологии.</li>
            <li>Работа с бюджетами от 300 000 ₽/мес.</li>
            <li>Опыт в 29+ нишах и сертификация по Яндекс.Директ.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="diag-section diag-audit" aria-labelledby="diag-audit-heading">
      <div class="container">
        <div class="diag-section__lead diag-section__lead--wide">
          <p class="diag-kicker">Что получите за 30 минут</p>
          <h2 id="diag-audit-heading">Бесплатная диагностика рекламного кабинета ВК / Яндекс.Директ</h2>
          <p>Обычная цена — 4 990 ₽. Сейчас — 0 ₽ для владельцев стоматологий.</p>
        </div>

        <div class="diag-audit__grid">
          {diagnosticResults.map((item) => (
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 12 4 4L19 6" />
              </svg>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="diag-section diag-steps" aria-labelledby="diag-steps-heading">
      <div class="container">
        <div class="diag-section__lead diag-section__lead--wide">
          <p class="diag-kicker">Шаги к результату</p>
          <h2 id="diag-steps-heading">Как пройдёт диагностика</h2>
        </div>

        <div class="diag-steps__list">
          {auditSteps.map((step) => (
            <article>
              <span>{step.time}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="diag-section diag-bonus" aria-labelledby="diag-bonus-heading">
      <div class="container diag-bonus__inner">
        <div>
          <p class="diag-kicker">Сверх диагностики</p>
          <h2 id="diag-bonus-heading">Бонус первым 3 клиникам в этом месяце</h2>
          <p>
            Бесплатная стратегическая консультация «Как удвоить поток пациентов за 14 дней без увеличения бюджета» — отдельный созвон, где разбираем всю систему привлечения целиком.
          </p>
        </div>
        <figure>
          <div class="diag-photo diag-photo--call">
            <span>Фото: созвон, ноутбук, кабинет рекламы</span>
          </div>
          <figcaption>Можно заменить на фото рабочего процесса или короткий скрин структуры аудита.</figcaption>
        </figure>
      </div>
    </section>

    <section id="diag-cta" class="diag-section diag-cta" aria-labelledby="diag-cta-heading">
      <div class="container diag-cta__inner">
        <div class="diag-cta__copy">
          <p class="diag-kicker">Финальный шаг</p>
          <h2 id="diag-cta-heading">Каждый день без нормально настроенной рекламы стоит вам денег</h2>
          <p>
            Пока вы читаете эту страницу — у конкурента через дорогу уже идёт очередная запись на имплантацию. Диагностика бесплатная. 30 минут. Без обязательств.
          </p>
          <p class="diag-cta__ps">
            P.S. Если у вас сейчас не настроена реклама вообще — тоже приходите. Покажу, с чего начать, чтобы не повторить ошибки тех, кто уже слил полмиллиона.
          </p>
        </div>

        <form class="diag-form" aria-label="Заявка на бесплатную диагностику">
          <div class="diag-form__head">
            <span>Лично свяжусь за 10 минут</span>
            <h3>Заявка на диагностику</h3>
          </div>
          <label>
            Ваше имя
            <input name="name" type="text" autocomplete="name" />
          </label>
          <label>
            Телефон или Telegram
            <input name="contact" type="text" autocomplete="tel" />
          </label>
          <label>
            Сайт клиники / город
            <input name="clinic" type="text" />
          </label>
          <label>
            Что сейчас происходит с рекламой?
            <textarea name="message" rows="4"></textarea>
          </label>
          <button type="button">Записаться на бесплатную диагностику</button>
          <p>Никаких менеджеров и отделов продаж. Пишу или звоню лично я.</p>
        </form>
      </div>
    </section>

    <section class="diag-photo-plan" aria-labelledby="diag-photo-plan-heading">
      <div class="container diag-photo-plan__inner">
        <h2 id="diag-photo-plan-heading">Какие фото потом заменить на реальные</h2>
        <ul>
          {photoSlots.map((slot) => <li>{slot}</li>)}
        </ul>
      </div>
    </section>

    <a class="diag-sticky" href="#diag-cta">Записаться</a>
  </main>

  <Footer />
  <CookieBanner />
</Base>

<style>
  :global(body) {
    background: #fbfbf8;
    color: #13201f;
  }

  .diagnostics-page {
    --diag-ink: #13201f;
    --diag-muted: #65706d;
    --diag-line: rgba(19, 32, 31, 0.12);
    --diag-soft: #f2f7f4;
    --diag-blue: #e8f2ff;
    --diag-mint: #dff4ea;
    --diag-amber: #fff1c7;
    --diag-accent: #e94b1b;
    --diag-green: #18784f;
    background:
      linear-gradient(180deg, #fbfbf8 0%, #ffffff 36%, #f6faf7 100%);
  }

  .diagnostics-page :global(section:nth-of-type(even)) {
    background: transparent;
  }

  .diag-section {
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .diag-kicker {
    width: fit-content;
    margin: 0 0 1rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--diag-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--diag-green);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .diag-section__lead {
    max-width: 540px;
  }

  .diag-section__lead--wide {
    max-width: 820px;
    margin-block-end: clamp(1.5rem, 4vw, 3rem);
  }

  .diag-section h2,
  .diag-hero h1 {
    margin: 0;
    color: var(--diag-ink);
    letter-spacing: 0;
    line-height: 0.98;
  }

  .diag-section h2 {
    max-width: 920px;
    font-size: clamp(2.15rem, 6vw, 5.6rem);
  }

  .diag-section__lead p,
  .diag-problem__copy p,
  .diag-author__copy p,
  .diag-bonus p,
  .diag-cta__copy p {
    color: var(--diag-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.55;
  }

  .diag-button,
  .diag-form button,
  .diag-sticky {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.9rem 1.3rem;
    border: 0;
    border-radius: 8px;
    background: var(--diag-accent);
    color: #fff;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 0 14px 28px rgba(233, 75, 27, 0.24);
    cursor: pointer;
  }

  .diag-hero {
    position: relative;
    min-height: min(860px, 92svh);
    overflow: hidden;
    padding-block: clamp(4rem, 7vw, 7rem) clamp(3rem, 5vw, 5rem);
    background: #eff7f1;
  }

  .diag-hero__media {
    position: absolute;
    inset: clamp(1rem, 2.5vw, 2rem);
    border-radius: 8px;
    overflow: hidden;
    background: linear-gradient(135deg, #ffffff 0%, #e6f4ee 45%, #dcecff 100%);
  }

  .diag-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(251, 251, 248, 0.98) 0%, rgba(251, 251, 248, 0.86) 42%, rgba(251, 251, 248, 0.2) 100%),
      linear-gradient(0deg, rgba(251, 251, 248, 0.9), rgba(251, 251, 248, 0));
  }

  .diag-hero__inner {
    position: relative;
    display: grid;
    min-height: calc(min(860px, 92svh) - clamp(7rem, 12vw, 12rem));
    align-content: end;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .diag-hero__copy {
    max-width: 820px;
    padding-block-start: clamp(1rem, 4vw, 3rem);
  }

  .diag-hero h1 {
    font-size: clamp(2.8rem, 5.6vw, 5rem);
    max-width: 18ch;
  }

  .diag-hero__copy > p:not(.diag-kicker) {
    max-width: 760px;
    margin: 1.4rem 0 0;
    color: #344541;
    font-size: clamp(1.12rem, 1.7vw, 1.45rem);
    line-height: 1.52;
  }

  .diag-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block-start: 2rem;
  }

  .diag-hero__actions span {
    max-width: 360px;
    color: var(--diag-muted);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .diag-hero__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    max-width: 880px;
  }

  .diag-hero__metrics article {
    padding: 1rem;
    border: 1px solid rgba(19, 32, 31, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(12px);
  }

  .diag-hero__metrics strong {
    display: block;
    color: var(--diag-ink);
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    line-height: 1;
  }

  .diag-hero__metrics span {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--diag-muted);
    line-height: 1.35;
  }

  .diag-photo {
    position: relative;
    display: grid;
    min-height: 320px;
    border: 1px dashed rgba(19, 32, 31, 0.26);
    border-radius: 8px;
    overflow: hidden;
    place-items: center;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(232, 242, 255, 0.65)),
      repeating-linear-gradient(45deg, rgba(19, 32, 31, 0.07) 0 1px, transparent 1px 14px);
  }

  .diag-photo span {
    max-width: 18rem;
    padding: 0.75rem 0.9rem;
