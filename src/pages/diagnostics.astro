---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/sections/Footer.astro';
import CookieBanner from '@/components/ui/CookieBanner.astro';

const painCards = [
  {
    tag: 'Деньги',
    title: 'Бюджет уходит, кресла пустуют',
    body: 'Вы уже платили агентствам по 60–150 тысяч в месяц, видели отчёты с кликами и охватами, но не видели нормального потока пациентов.',
  },
  {
    tag: 'Заявки',
    title: 'Звонят не те люди',
    body: 'Администратор слышит вопросы про бесплатное удаление, дешёвые акции и случайные консультации вместо заявок на имплантацию.',
  },
  {
    tag: 'Контроль',
    title: 'Приходится проверять всё самому',
    body: 'Вечером вы снова открываете отчёты и Excel, потому что уже не понимаете, кому можно доверять рекламный кабинет.',
  },
];

const heroFeatures = [
  {
    title: 'Понятно владельцу',
    body: 'Без рекламного жаргона: показываю деньги, заявки и потери.',
  },
  {
    title: 'Без новых тестов',
    body: 'Сначала разбираем текущий кабинет, потом решаем, что запускать.',
  },
  {
    title: 'Лично Ростислав',
    body: 'Никаких менеджеров и отделов продаж на первом контакте.',
  },
  {
    title: 'Конспект после созвона',
    body: 'Короткий план с цифрами и следующими действиями.',
  },
];

const leakCards = [
  'Алгоритм Яндекса или ВК первые 3–4 недели обучается на вашем бюджете.',
  'Реклама показывается школьникам, пенсионерам и людям с дешёвыми запросами.',
  'Вы оплачиваете клики людей, которые никогда не купят имплантацию за 80 000 ₽.',
  'Через месяц агентство просит ещё времени на тесты, а лизинг и аренда продолжают капать.',
];

const navigatorBlocks = [
  {
    title: 'Данные-доноры',
    body: 'Готовые аудитории людей, которые уже платили за дорогое лечение.',
  },
  {
    title: 'Офферы под стоматологию',
    body: 'Связки под имплантацию, виниры, All-on-4 и ортодонтию.',
  },
  {
    title: 'Модерация',
    body: 'Креативы, которые легче проходят правила медицинской рекламы.',
  },
  {
    title: 'Минус-фразы',
    body: '200+ исключений против запросов «бесплатно», «дёшево», «по акции».',
  },
];

const comparisonRows = [
  ['3–4 недели обучения за ваш счёт', 'Заявки уже на 3–5 день'],
  ['Трафик «всем подряд»', 'Платёжеспособные пациенты'],
  ['Запросы про бесплатное удаление', 'Имплантация, виниры, All-on-4'],
  ['CAC 8 000–15 000 ₽', 'CAC до 4 000 ₽ за запись'],
  ['«Нужно ещё потестить»', 'Прогнозируемые 30–50 пациентов в месяц'],
];

const auditItems = [
  'Покажу, где конкретно сливаются деньги в кабинете.',
  'Посчитаем, сколько сейчас стоит пациент и сколько он должен стоить.',
  'Оценим, можно ли выйти на 30–50 платёжеспособных записей в месяц.',
  'Соберём план внедрения «Умного Навигатора» под вашу клинику.',
];

const callSteps = [
  ['5 мин', 'Смотрим кабинет', 'Я.Директ или ВК: кампании, бюджеты, ставки, аудитории.'],
  ['10 мин', 'Находим слив', 'Запросы, аудитории, минус-фразы и участки, где деньги уходят впустую.'],
  ['8 мин', 'Считаем экономику', 'Текущая цена пациента, нормальная рыночная цена и потери за месяц.'],
  ['7 мин', 'Собираем план', 'Какие связки подойдут под имплантацию, виниры, ортодонтию или All-on-4.'],
];

const photoNotes = [
  'Hero: Ростислав в клинике или светлый стоматологический кабинет.',
  'Разбор: скрин рекламного кабинета с замазанными данными и пометками.',
  'Автор: живой портрет Ростислава без стоковой постановки.',
  'Финал: фото созвона или ноутбука с открытым аудитом.',
];
---

<Base
  title="Диагностика рекламы для стоматологий"
  description="30-минутная диагностика рекламного кабинета ВК и Яндекс.Директ для владельцев стоматологических клиник."
>
  <main id="main-content" class="med-page">
    <section class="med-hero" aria-labelledby="med-hero-title">
      <div class="container med-hero__inner">
        <header class="med-topbar" aria-label="Контакты и действие">
          <a class="med-brand" href="/">
            <strong>DIRECT METHOD</strong>
            <span>реклама для стоматологий</span>
          </a>
          <div class="med-topbar__meta">
            <span>Ответ в Telegram за 10 минут</span>
            <span>ПН–ПТ · 9:00–20:00</span>
          </div>
          <a class="med-topbar__button" href="#diagnostics-form">Вам перезвонить?</a>
        </header>

        <div class="med-hero__stage">
          <div class="med-hero__content">
            <p class="med-pill">Бесплатная диагностика ВК / Яндекс.Директ</p>
            <h1 id="med-hero-title">
              Сливаете 100 000 ₽/мес на рекламу, а в кресле пусто?
            </h1>
            <p class="med-hero__lead">
              За 30 минут покажу, где утекают деньги, и как получать 30–50 платёжеспособных пациентов в месяц на имплантацию по цене до 1 500 ₽ за запись.
            </p>
            <div class="med-hero__actions">
              <a class="med-btn" href="#diagnostics-form">Открыть доступ</a>
              <span>Обычная цена 4 990 ₽. Сейчас 0 ₽ для владельцев стоматологий.</span>
            </div>
          </div>

          <aside class="med-hero__person" aria-label="Кто проводит диагностику">
            <strong>Ростислав Загребин</strong>
            <span>специалист по рекламе в медицине</span>
          </aside>

          <div class="med-hero__visual" aria-hidden="true">
            <svg class="med-hero-illustration" viewBox="0 0 520 620" role="img" aria-label="Схема диагностики рекламы для стоматологии">
              <rect x="70" y="92" width="342" height="422" rx="34" fill="#fffdf6" stroke="#c9ddd1" stroke-width="3"/>
              <rect x="104" y="134" width="274" height="54" rx="18" fill="#dceee7"/>
              <rect x="104" y="218" width="128" height="112" rx="24" fill="#bfe8e0"/>
              <rect x="250" y="218" width="128" height="112" rx="24" fill="#ecf4ef"/>
              <rect x="104" y="358" width="274" height="28" rx="14" fill="#dceee7"/>
              <rect x="104" y="408" width="214" height="28" rx="14" fill="#dceee7"/>
              <circle cx="410" cy="430" r="68" fill="#167a5b"/>
              <path d="M380 429l21 21 43-54" fill="none" stroke="#fffdf6" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M145 285c28-42 57-42 85 0" fill="none" stroke="#167a5b" stroke-width="10" stroke-linecap="round"/>
              <path d="M282 282h64" stroke="#789187" stroke-width="10" stroke-linecap="round"/>
            </svg>
          </div>
        </div>

        <div class="med-hero__features" aria-label="Что входит в диагностику">
          {heroFeatures.map((feature) => (
            <article>
              <span></span>
              <p><strong>{feature.title}</strong>{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="med-section med-pain" aria-labelledby="med-pain-title">
      <div class="container">
        <div class="med-section__head">
          <p class="med-pill">Ситуация владельца</p>
          <h2 id="med-pain-title">Проблема выглядит не как “нет рекламы”. Проблема выглядит как отсутствие доверия к рекламе.</h2>
        </div>

        <div class="med-pain__grid">
          {painCards.map((card) => (
            <article class="med-card">
              <span>{card.tag}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </div>

        <p class="med-note">
          Конкурент через дорогу демпингует «имплант за 19 900», сарафан закончился, а новый маркетолог снова обещает лиды по 300 рублей.
        </p>
      </div>
    </section>

    <section class="med-section med-leak" aria-labelledby="med-leak-title">
      <div class="container med-leak__inner">
        <div class="med-leak__copy">
          <p class="med-pill">Настоящая причина</p>
          <h2 id="med-leak-title">Алгоритм учится вслепую. Вы оплачиваете каждый его тычок.</h2>
          <p>
            Дело не в том, что реклама в стоматологии больше не работает. Обычно кабинет запускают с нуля, и первые недели площадка сама пытается понять, кого искать.
          </p>
        </div>

        <div class="med-audit-card">
          <div class="med-photo med-photo--audit">
            <svg class="med-dashboard" viewBox="0 0 620 380" role="img" aria-label="Мокап рекламного кабинета с пометками аудита">
              <rect x="18" y="18" width="584" height="344" rx="26" fill="#fffdf6" stroke="#c9ddd1" stroke-width="3"/>
              <rect x="48" y="52" width="180" height="38" rx="14" fill="#dceee7"/>
              <rect x="48" y="120" width="126" height="98" rx="18" fill="#ecf4ef"/>
              <rect x="194" y="120" width="126" height="98" rx="18" fill="#ecf4ef"/>
              <rect x="340" y="120" width="126" height="98" rx="18" fill="#ecf4ef"/>
              <path d="M70 292c62-80 126-26 184-72 53-42 100-66 164 22 32 44 72 34 122-26" fill="none" stroke="#167a5b" stroke-width="10" stroke-linecap="round"/>
              <circle cx="248" cy="218" r="24" fill="#bfe8e0" stroke="#167a5b" stroke-width="5"/>
              <path d="M244 214l10 10 18-26" fill="none" stroke="#167a5b" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="486" y="62" width="70" height="30" rx="15" fill="#bfe8e0"/>
            </svg>
          </div>
          <h3>Что видно на разборе</h3>
          <ul>
            {leakCards.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="med-section med-method" aria-labelledby="med-method-title">
      <div class="container">
        <div class="med-method__intro">
          <p class="med-pill">Решение</p>
          <h2 id="med-method-title">«Умный Навигатор» даёт алгоритму ориентиры с первого дня</h2>
          <p>
            Я не начинаю с пустого кабинета. В запуск идут готовые данные, офферы, аудитории, креативы и минус-фразы, накопленные за 6 лет маркетинга и 10+ проектов в медицине.
          </p>
        </div>

        <div class="med-method__diagram" aria-label="Схема метода Умный Навигатор">
          {navigatorBlocks.map((block, index) => (
            <article>
              <span>{index + 1}</span>
              <h3>{block.title}</h3>
              <p>{block.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="med-section med-compare" aria-labelledby="med-compare-title">
      <div class="container">
        <div class="med-section__head">
          <p class="med-pill">До / после</p>
          <h2 id="med-compare-title">Что меняется в запуске</h2>
        </div>

        <div class="med-compare__list">
          {comparisonRows.map(([before, after]) => (
            <article>
              <p><span>Обычно</span>{before}</p>
              <p><span>С навигатором</span>{after}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="med-section med-offer" aria-labelledby="med-offer-title">
      <div class="container med-offer__inner">
        <div>
          <p class="med-pill">Бесплатная диагностика</p>
          <h2 id="med-offer-title">За 30 минут вы получите не “консультацию”, а разбор кабинета с цифрами</h2>
        </div>

        <div class="med-offer__items">
          {auditItems.map((item) => (
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="med-section med-steps" aria-labelledby="med-steps-title">
      <div class="container med-steps__inner">
        <div class="med-section__head">
          <p class="med-pill">Сценарий созвона</p>
          <h2 id="med-steps-title">Как пройдёт диагностика</h2>
        </div>

        <div class="med-steps__timeline">
          {callSteps.map(([time, title, body]) => (
            <article>
              <span>{time}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="med-section med-author" aria-labelledby="med-author-title">
      <div class="container med-author__inner">
        <figure class="med-author__media">
          <div class="med-photo med-photo--portrait">
            <svg class="med-portrait" viewBox="0 0 420 520" role="img" aria-label="Место под портрет Ростислава Загребина">
              <rect x="42" y="34" width="336" height="452" rx="42" fill="#fffdf6" stroke="#c9ddd1" stroke-width="3"/>
              <circle cx="210" cy="168" r="72" fill="#bfe8e0"/>
              <path d="M116 404c18-86 70-130 94-130s76 44 94 130" fill="#dceee7"/>
              <path d="M148 170c20 28 104 28 124 0" fill="none" stroke="#167a5b" stroke-width="10" stroke-linecap="round"/>
              <path d="M154 404h112" stroke="#789187" stroke-width="10" stroke-linecap="round"/>
            </svg>
          </div>
        </figure>

        <div class="med-author__copy">
          <p class="med-pill">Кто проводит разбор</p>
          <h2 id="med-author-title">Ростислав Загребин</h2>
          <p>
            6 лет в маркетинге, фокус — Яндекс.Директ и ВК для медицины. На первом клиенте сделал х10 по чистой прибыли за 1,5 года через Я.Директ и сайт.
          </p>
          <div class="med-author__facts">
            <span>10+ проектов в медицине</span>
            <span>Бюджеты от 300 000 ₽/мес</span>
            <span>29+ ниш для переноса связок</span>
            <span>Сертификация по Яндекс.Директ</span>
          </div>
        </div>
      </div>
    </section>

    <section id="diagnostics-form" class="med-section med-final" aria-labelledby="med-final-title">
      <div class="container med-final__inner">
        <div class="med-final__copy">
          <p class="med-pill">Финальный шаг</p>
          <h2 id="med-final-title">Каждый день без нормально настроенной рекламы стоит вам денег</h2>
          <p>
            Худшее, что может случиться: вы узнаете, где сейчас теряете деньги, и почините это сами. Никаких менеджеров и отделов продаж — пишу или звоню лично я.
          </p>

          <div class="med-bonus">
            <strong>Бонус первым 3 клиникам</strong>
            <span>Стратегическая консультация «Как удвоить поток пациентов за 14 дней без увеличения бюджета».</span>
          </div>

          <div class="med-photo med-photo--call">
            <svg class="med-call" viewBox="0 0 560 300" role="img" aria-label="Мокап созвона и аудита рекламного кабинета">
              <rect x="58" y="46" width="346" height="196" rx="22" fill="#fffdf6" stroke="#c9ddd1" stroke-width="3"/>
              <rect x="86" y="76" width="136" height="86" rx="18" fill="#dceee7"/>
              <rect x="244" y="80" width="116" height="18" rx="9" fill="#bfe8e0"/>
              <rect x="244" y="120" width="92" height="18" rx="9" fill="#dceee7"/>
              <rect x="244" y="160" width="128" height="18" rx="9" fill="#dceee7"/>
              <rect x="134" y="244" width="320" height="18" rx="9" fill="#789187"/>
              <circle cx="424" cy="98" r="50" fill="#167a5b"/>
              <path d="M400 99l16 16 34-44" fill="none" stroke="#fffdf6" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <form class="med-form" aria-label="Заявка на бесплатную диагностику">
          <div>
            <span>Свяжусь в течение 10 минут</span>
            <h3>Заявка на диагностику</h3>
          </div>
          <label>
            Ваше имя
            <input name="name" type="text" autocomplete="name" />
          </label>
          <label>
            Телефон или Telegram
            <input name="contact" type="text" autocomplete="tel" />
          </label>
          <label>
            Город и сайт клиники
            <input name="clinic" type="text" />
          </label>
          <label>
            Что сейчас происходит с рекламой?
            <textarea name="message" rows="4"></textarea>
          </label>
          <button type="button">Записаться на бесплатную диагностику</button>
          <p>Если реклама ещё не настроена, тоже приходите: покажу, с чего начать без слива бюджета.</p>
        </form>
      </div>
    </section>

    <section class="med-photo-guide" aria-labelledby="med-photo-guide-title">
      <div class="container med-photo-guide__inner">
        <h2 id="med-photo-guide-title">Места под реальные материалы</h2>
        <ul>
          {photoNotes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    </section>

    <a class="med-sticky" href="#diagnostics-form">Записаться</a>
  </main>

  <Footer />
  <CookieBanner />
</Base>

<style>
  :global(body) {
    background: #faf8f2;
    color: #17211f;
  }

  .med-page {
    --ink: #17211f;
    --muted: #6a746f;
    --line: rgba(23, 33, 31, 0.12);
    --paper: #fffdf6;
    --soft: #ddeadd;
    --mint: #bfe8e0;
    --mist: #ecf4ef;
    --accent: #167a5b;
    --accent-dark: #0f5c44;
    --green: #167a5b;
    --sage: #789187;
    --shadow: 0 18px 50px rgba(28, 69, 56, 0.09);
    background: linear-gradient(180deg, #faf8f2 0%, #fffdf6 42%, #f1f7f2 100%);
  }

  .med-page :global(section:nth-of-type(even)) {
    background: transparent;
  }

  .med-section {
    padding-block: 88px;
  }

  .med-pill {
    display: inline-flex;
    margin: 0 0 18px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 254, 250, 0.84);
    color: var(--green);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .med-page h1,
  .med-page h2,
  .med-page h3,
  .med-page p {
    letter-spacing: 0;
  }

  .med-page h1,
  .med-page h2 {
    margin: 0;
    color: var(--ink);
    font-weight: 900;
    line-height: 1.02;
  }

  .med-page h1 {
    max-width: 740px;
    font-size: 76px;
  }

  .med-page h2 {
    max-width: 880px;
    font-size: 54px;
  }

  .med-page h3 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.1;
  }

  .med-page p {
    color: var(--muted);
    line-height: 1.55;
  }

  .med-section__head {
    max-width: 880px;
    margin-block-end: 34px;
  }

  .med-btn,
  .med-form button,
  .med-sticky {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 900;
    letter-spacing: 0;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 14px 30px rgba(22, 122, 91, 0.22);
  }

  .med-hero {
    position: relative;
    overflow: hidden;
    padding-block: 50px 54px;
    background:
      linear-gradient(90deg, rgba(250, 248, 242, 0.98) 0%, rgba(250, 248, 242, 0.9) 49%, rgba(250, 248, 242, 0.28) 100%),
      radial-gradient(circle at 83% 24%, rgba(191, 232, 224, 0.52), transparent 24%),
      linear-gradient(135deg, #faf8f2, #edf4ed 58%, #dceee7);
  }

  .med-hero__inner {
    display: grid;
    gap: 40px;
    min-height: 840px;
  }

  .med-topbar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
