---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/landing/Hero.astro";
import PainSection from "@/components/landing/PainSection.astro";
import AudienceSection from "@/components/landing/AudienceSection.astro";
import InsideSection from "@/components/landing/InsideSection.astro";
import ProgramSection from "@/components/landing/ProgramSection.astro";
import PricingSection from "@/components/landing/PricingSection.astro";
import FaqSection from "@/components/landing/FaqSection.astro";
import FinalCta from "@/components/landing/FinalCta.astro";
---

<BaseLayout>
  <Header />
  <main class="home-main">
    <Hero />
    <PainSection />
    <InsideSection />
    <ProgramSection />
    <AudienceSection />
    <PricingSection />
    <FaqSection />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
