---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Страница не найдена" noindex={true}>
  <Header />
  <main class="not-found-page" id="top">
    <section class="section not-found-hero">
      <div class="not-found-card reveal">
        <div>
          <p class="eyebrow">404 • страница не найдена</p>
          <h1>Похоже, этот кабинет уже закрыт.</h1>
          <p>
            Ссылка ведёт в пустой коридор. Вернитесь на главную или оставьте заявку
            на диагностику рекламы стоматологии.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={`${base}#lead-form`}>К форме диагностики</a>
            <a class="button ghost" href={`${base}#lead-form`}>Записаться на диагностику</a>
          </div>
        </div>
        <div class="not-found-visual" aria-label="Ошибка 404">
          <img
            src={`${base}images/dental-empty-chair-bg.webp`}
            alt="Пустое стоматологическое кресло"
            loading="eager"
            decoding="async"
          />
          <div class="not-found-code">
            <span>HTTP 404</span>
            <strong>Пустое окно</strong>
            <p>Страница не найдена, но диагностику рекламы можно открыть за 30 минут.</p>
            <a href={`${base}#lead-form`}>Оставить заявку</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
