---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const nextSteps = [
  "Я проверю заявку и свяжусь с вами, чтобы согласовать удобное время.",
  "На созвоне разберём ВК или Яндекс.Директ: кампании, заявки, стоимость пациента.",
  "После диагностики вы получите короткий план, что чинить в первую очередь.",
];
---

<BaseLayout
  title="Заявка на диагностику принята"
  description="Спасибо за заявку на бесплатную диагностику рекламы стоматологической клиники."
  noindex={true}
>
  <Header />
  <main class="thank-page" id="top">
    <section class="section thank-hero">
      <div class="thank-card thank-card--lead reveal">
        <div class="thank-copy">
          <p class="eyebrow">Заявка отправлена</p>
          <h1>Спасибо. Я скоро свяжусь с вами.</h1>
          <p>
            Заявка на бесплатную диагностику рекламы принята. Обычно я отвечаю в течение
            рабочего дня и предлагаю несколько слотов для 30-минутного разбора.
          </p>
          <p class="thank-note">
            Если вопрос срочный, можно сразу написать в Telegram или на email поддержки.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={site.telegramUrl}>Написать в Telegram</a>
            <a class="button ghost" href={`mailto:${site.supportEmail}`}>Email</a>
            <a class="button ghost" href={base}>На главную</a>
          </div>
        </div>

        <div class="thank-side">
          <div class="thank-dental-visual">
            <img
              src={`${base}images/dental-diagnostics-bg.webp`}
              alt="Кабинет стоматологии и аналитика рекламных заявок"
              loading="eager"
              decoding="async"
            />
            <div class="thank-dental-badge">
              <span>30 минут</span>
              <strong>Кабинет, заявки, стоимость пациента</strong>
            </div>
          </div>
          <div class="mini-steps">
            {nextSteps.map((step, index) => (
              <div>
                <span>{index + 1}</span>
                <p>{step}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
