---
import { cookie } from '@/content/site';
import { withBase } from '@/utils/paths';
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label="Уведомление об использовании cookies"
  aria-live="polite"
>
  <p class="cookie-banner__text">
    {cookie.text}
    <a href={withBase(cookie.policyHref)} class="cookie-banner__link">{cookie.policyLabel}</a>.
  </p>
  <button
    id="cookie-accept"
    class="cookie-banner__btn"
    type="button"
    aria-label="Принять использование cookies"
  >
    {cookie.acceptLabel}
  </button>
</div>

<script>
  const STORAGE_KEY = 'cookie-accepted';
  const banner = document.getElementById('cookie-banner');
  const btn    = document.getElementById('cookie-accept');

  if (banner) {
    if (localStorage.getItem(STORAGE_KEY)) {
      banner.remove();
    } else {
      // Fade in on next frame so CSS transition fires
      requestAnimationFrame(() => banner.classList.add('cookie-banner--visible'));

      btn?.addEventListener('click', () => {
        localStorage.setItem(STORAGE_KEY, '1');
        banner.classList.remove('cookie-banner--visible');
        banner.addEventListener('transitionend', () => banner.remove(), { once: true });
      });
    }
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 999;
    background-color: var(--color-text-strong);
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--container-pad);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.18);

    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .cookie-banner--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .cookie-banner__text {
    flex: 1 1 260px;
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .cookie-banner__link {
    color: var(--color-accent-2);
    text-decoration: underline;
  }

  .cookie-banner__link:hover { color: #fff; }

  .cookie-banner__btn {
    flex-shrink: 0;
    padding: 0.55em 1.5em;
    background-color: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: var(--radius-btn);
    font-family: var(--font-family);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--duration-fast);
    outline: 3px solid transparent;
    outline-offset: 3px;
  }

  .cookie-banner__btn:hover  { background-color: var(--color-accent-hover); }
  .cookie-banner__btn:focus-visible { outline-color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner { transition: none; }
    .cookie-banner__btn { transition: none; }
  }
</style>
