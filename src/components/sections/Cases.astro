---
import { cases } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';

// Placeholder result snippets — replaced when real cases are added to site.ts
const resultSnippets = [
  'С 2 до 6 млн за 3 месяца',
  '+400к и спокойная жизнь',
  'Первый запуск на 800к',
  'Х3 к доходу без выгорания',
  'Вышла из найма за 2 месяца',
  'Запуск на 1.2 млн с нуля',
  'С 80к до 350к ежемесячно',
  'Продала на 500к в первый месяц',
  'Системный доход без хаоса',
  'Закрыла 12 клиентов за месяц',
  'Чек вырос в 2.5 раза',
  'Запуск 2.4 млн без базы',
];
---

<section class="cases" aria-labelledby="cases-heading">
  <div class="container">
    <SectionHeading
      id="cases-heading"
      heading={cases.heading}
      sub="Результаты клиентов — в цифрах и фактах"
      align="center"
    />

    <ul class="cases__grid" role="list">
      {cases.items.map((item, i) => (
        <li class="cases__card">
          <!-- Placeholder screenshot with result label -->
          <div class="cases__thumb" aria-label={`Кейс: ${resultSnippets[i] ?? item.result}`}>
            <svg viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id={`case-bg-${i}`} x1="0" y1="0" x2="280" y2="200" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color={i % 3 === 0 ? '#f5f5f5' : i % 3 === 1 ? '#f9f3ed' : '#f0f5f9'}/>
                  <stop offset="100%" stop-color={i % 3 === 0 ? '#e8e8e8' : i % 3 === 1 ? '#f0e4d8' : '#dde8f0'}/>
                </linearGradient>
              </defs>
              <rect width="280" height="200" rx="8" fill={`url(#case-bg-${i})`}/>
              <!-- mock chat/screenshot lines -->
              <rect x="16" y="20" width="48" height="48" rx="24" fill="#d4d4d4" opacity="0.8"/>
              <rect x="72" y="24" width="140" height="8" rx="3" fill="#c8c8c8" opacity="0.9"/>
              <rect x="72" y="38" width="100" height="8" rx="3" fill="#c8c8c8" opacity="0.6"/>
              <rect x="16" y="84" width="220" height="8" rx="3" fill="#c8c8c8" opacity="0.7"/>
              <rect x="16" y="100" width="180" height="8" rx="3" fill="#c8c8c8" opacity="0.5"/>
              <rect x="16" y="116" width="200" height="8" rx="3" fill="#c8c8c8" opacity="0.5"/>
              <!-- result badge -->
              <rect x="12" y="152" width={Math.min(200, 80 + (resultSnippets[i]?.length ?? 10) * 6)} height="28" rx="6" fill="#eb4100"/>
              <text x="22" y="170" font-family="Arial" font-size="10" font-weight="700" fill="white">
                {resultSnippets[i] ?? item.result}
              </text>
            </svg>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cases {
    background-color: var(--color-bg);
    padding-block: var(--space-section);
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cases__card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .cases__card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }

  .cases__thumb svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 1024px) { .cases__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 680px)  { .cases__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 400px)  { .cases__grid { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) {
    .cases__card { transition: none; }
    .cases__card:hover { transform: none; }
  }
</style>
