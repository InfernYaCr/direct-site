---
import { reviews } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const sentiments = ['🔥', '💯', '🚀', '✅', '⭐', '💪', '🎯', '👏', '🙌'];
const reviewTexts = [
  'Наконец-то понял, как строить системные продажи. Результат — х2 к чеку.',
  'Лучший курс по продажам, который я проходила. Без воды, только практика.',
  'За 2 недели закрыла клиентов на 300к. Рекомендую всем экспертам.',
  'Программа перевернула мой подход к текстам. Продажи выросли в 3 раза.',
  'Наконец понял, почему не покупали. Исправил — и сразу результат.',
  'Очень структурировано и понятно. Сразу внедрила и получила отклик.',
  'Стратегия реально работает. Первый запуск после обучения — 800к.',
  'Никита объясняет так, что всё становится на своё место.',
  'Самые честные и рабочие техники, которые я встречала.',
];
---

<section class="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <SectionHeading
      id="reviews-heading"
      heading={reviews.heading}
      align="center"
    />

    <ul class="reviews__grid" role="list">
      {reviews.items.map((_item, i) => (
        <li class="reviews__card">
          <div class="reviews__card-header">
            <div class="reviews__avatar" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="20" fill={`hsl(${(i * 37 + 15) % 360}, 40%, 80%)`}/>
                <circle cx="20" cy="16" r="7" fill={`hsl(${(i * 37 + 15) % 360}, 35%, 65%)`}/>
                <ellipse cx="20" cy="38" rx="12" ry="8" fill={`hsl(${(i * 37 + 15) % 360}, 35%, 65%)`}/>
              </svg>
            </div>
            <div>
              <p class="reviews__name">Клиент {i + 1}</p>
              <p class="reviews__stars" aria-label="5 звёзд">★★★★★</p>
            </div>
            <span class="reviews__sentiment" aria-hidden="true">{sentiments[i]}</span>
          </div>
          <p class="reviews__text">{reviewTexts[i]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-section);
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reviews__card {
    background-color: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .reviews__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .reviews__card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviews__avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
  }

  .reviews__avatar svg { width: 100%; height: 100%; }

  .reviews__name {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0;
    line-height: 1.2;
  }

  .reviews__stars {
    font-size: var(--text-small);
    color: var(--color-accent-2);
    margin: 0;
    line-height: 1.2;
  }

  .reviews__sentiment {
    margin-inline-start: auto;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .reviews__text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  @media (max-width: 900px) { .reviews__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .reviews__grid { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) {
    .reviews__card { transition: none; }
    .reviews__card:hover { transform: none; }
  }
</style>
