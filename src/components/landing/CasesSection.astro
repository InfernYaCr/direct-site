---
import SectionHeading from "@/components/SectionHeading.astro";
import { cases, testimonials } from "@/data/site";
---

<section class="section" id="proof">
  <SectionHeading
    eyebrow="Кому это уже помогло"
    title="Реальные ситуации QA: что было и что изменилось после набора"
    text="Без громких обещаний — просто как меняется подход: от хаотичного ChatGPT к понятному плану, проверкам и проекту."
  />
  <div class="case-grid">
    {cases.map((item) => (
      <article class="case-card reveal">
        <span>{item.role}</span>
        <h3>{item.title}</h3>
        <p>{item.result}</p>
      </article>
    ))}
  </div>
  <div class="testimonial-row">
    {testimonials.map((item) => (
      <article class="testimonial-card reveal">
        <p>“{item.text}”</p>
        <div>
          <strong>{item.name}</strong>
          <span>{item.role}</span>
        </div>
      </article>
    ))}
  </div>
</section>
