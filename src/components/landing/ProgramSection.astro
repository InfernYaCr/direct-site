---
import SectionHeading from "@/components/SectionHeading.astro";
import { program } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const compareRows = [
  ["3–4 недели обучения за ваш счёт", "Заявки уже на 3–5 день"],
  ["Случайный трафик «всем подряд»", "Только платёжеспособные пациенты"],
  ["Заявки «на бесплатное удаление»", "Заявки на имплантацию, виниры, All-on-4"],
  ["САС 8 000–15 000 ₽", "САС до 4 000 ₽ за запись"],
  ["«Дайте ещё месяц на тесты»", "Прогнозируемые 30–50 пациентов/мес"],
];
---

<section class="section soft" id="program">
  <SectionHeading
    eyebrow="Решение"
    title="Как работает метод <span class='text-blue'>«Умный Навигатор»</span>"
    text="Я полностью убираю фазу обучения. Алгоритм с первого дня знает, кого искать, потому что мы не начинаем с нуля."
  />
  <div class="program-wrap">
    <div class="program-card reveal">
      <p class="eyebrow">Что уже подготовлено</p>
      <ol>
        {program.map((item) => <li>{item}</li>)}
      </ol>
    </div>
    <aside
      class="seo-note program-visual-note reveal delay-1"
      data-scroll-card
      data-scroll-scope="#program .program-wrap"
      style={`--program-bg: url("${base}images/dental-growth-analytics-bg.webp")`}
    >
      <div class="program-visual-note__copy scroll-photo-copy" data-scroll-copy>
        <h3>Ключевые темы</h3>
        <p>
          Когда мы запускаем вашу клинику, я не начинаю с нуля. Я загружаю
          в ваш кабинет готовые «данные-доноры» — и алгоритм мгновенно
          переходит в рабочий режим.
        </p>
        <a class="button ghost" href="#diagnostic-request">Записаться на диагностику</a>
      </div>
    </aside>
  </div>

  <div class="program-compare reveal">
    <p class="program-compare__caption">Что это даёт вам</p>
    <div class="compare">
      <div class="compare__row compare__row--head">
        <div class="compare__head compare__head--bad">Стандартное агентство</div>
        <div class="compare__head compare__head--good">Метод «Умный Навигатор»</div>
      </div>
      {compareRows.map(([bad, good]) => (
        <div class="compare__row">
          <div class="compare__cell compare__cell--bad">
            <span class="compare__icon" aria-hidden="true">✕</span>
            <span>{bad}</span>
          </div>
          <div class="compare__cell compare__cell--good">
            <span class="compare__icon" aria-hidden="true">✓</span>
            <span>{good}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="pain-conclusion reveal">
    <span class="pain-conclusion__mark" aria-hidden="true"></span>
    <p class="pain-conclusion__text">
      Маркетинг работает как кран:
      <span class="text-blue">открыли бюджет — пошли пациенты</span>. Закрыли — встало.
    </p>
  </div>
</section>

<script>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const updateScrollPhotoCopy = () => {
    const cards = document.querySelectorAll("[data-scroll-card]");
    const viewportHeight = window.innerHeight;
    const isMobile = window.innerWidth <= 760;

    cards.forEach((card) => {
      const copy = card.querySelector("[data-scroll-copy]");
      if (!copy) return;

      if (isMobile) {
        copy.style.setProperty("--photo-copy-y", "0px");
        return;
      }

      const scopeSelector = card.dataset.scrollScope;
      const scope = scopeSelector
        ? document.querySelector(scopeSelector)
        : card;
      const rect = (scope ?? card).getBoundingClientRect();
      const travel = Math.max(rect.height - card.clientHeight, viewportHeight * 0.72);
      const startOffset = viewportHeight * 0.45;
      const progress = clamp((startOffset - rect.top) / travel, 0, 1);
      const top = parseFloat(getComputedStyle(copy).top || "0") || 0;
      const bottomPad = 28;
      const maxY = Math.max(0, card.clientHeight - copy.offsetHeight - top - bottomPad);

      copy.style.setProperty("--photo-copy-y", `${Math.round(maxY * progress)}px`);
    });
  };

  let ticking = false;
  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateScrollPhotoCopy();
      ticking = false;
    });
  };

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);
  window.addEventListener("load", updateScrollPhotoCopy);
  updateScrollPhotoCopy();
</script>
