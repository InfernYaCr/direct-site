---
import SectionHeading from "@/components/SectionHeading.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const pains = [
  "Уже отдали 2–3 агентствам по 60–150 тысяч в месяц. Получили красивые отчёты с «кликами» и «охватами» — а в кассе пусто.",
  "Администратор говорит: «звонят не те, спрашивают только „удалить зуб бесплатно“».",
  "Хирурги-имплантологи сидят без работы, а лизинг за оборудование и аренду никто не отменял.",
  "Вечерами сами лезете в отчёты и считаете заявки в Excel — потому что доверять уже некому.",
  "Сарафан закончился, конкурент через дорогу демпингует «имплант за 19 900», а вы честно держите 45 000 — и проигрываете.",
  "Каждый новый маркетолог обещает «лиды по 300 рублей», а через месяц — снова кассовый разрыв.",
  "И главное ощущение — вы не понимаете, кому ещё можно верить.",
];
---

<section class="section soft" id="pain">
  <SectionHeading
    eyebrow="Если вы владелец клиники"
    title="Вам это <span class='text-blue'>знакомо</span>"
    text="Реклама вроде работает, отчёты выглядят красиво, но в расписании хирурга-имплантолога всё равно пустые окна."
  />
  <div class="pain-board reveal">
    <article
      class="pain-board__main"
      style={`--pain-bg: url("${base}images/dental-empty-chair-bg.webp")`}
    >
      <span>главный симптом</span>
      <h3>Деньги уходят, а платёжеспособных записей нет</h3>
      <p>{pains[0]}</p>
    </article>
    <div class="pain-board__rail">
      {pains.slice(1).map((pain, index) => (
        <article class="pain-board__item">
          <span>{String(index + 2).padStart(2, "0")}</span>
          <p>{pain}</p>
        </article>
      ))}
    </div>
  </div>
</section>
