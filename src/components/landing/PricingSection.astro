---
import SectionHeading from "@/components/SectionHeading.astro";
import { leadMagnet } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="section" id="pricing">
  <SectionHeading
    eyebrow="Бесплатная диагностика"
    title="<span class='text-blue'>Разберу</span> ваш рекламный кабинет и покажу, где клиника <span class='text-red'>теряет заявки</span>"
    text="30 минут по цифрам ВК или Яндекс.Директ: покажу, где сливается бюджет и что чинить первым."
  />

  <div class="diagnostic-offer reveal" id="free-guide">
    <div class="diagnostic-offer__media">
      <img
        src={`${base}images/dental-diagnostics-bg.webp`}
        alt="Аналитика рекламы и планирование лечения в стоматологической клинике"
        loading="lazy"
        decoding="async"
      />
      <div class="diagnostic-media-card">
        <span>что проверю</span>
        <strong>Кабинет, заявки, стоимость пациента</strong>
      </div>
    </div>
    <div class="diagnostic-offer__content">
      <div class="diagnostic-offer__top">
        <div>
          <p class="eyebrow">Оффер для владельцев клиник</p>
          <h3>Диагностика рекламы без гадания по отчётам</h3>
        </div>
        <div class="diagnostic-price">
          <span>Обычно</span>
          <del>4 990 ₽</del>
          <strong>0 ₽</strong>
          <small>сейчас</small>
        </div>
      </div>
      <p class="diagnostic-lead">
        Покажу, где бюджет уходит на случайный трафик, слабые связки и заявки
        без записи.
      </p>
      <ul class="diagnostic-list">
        <li>Полный разбор рекламного кабинета ВК / Яндекс.Директ</li>
        <li>Цифры: сколько вы переплачиваете за пациента сейчас</li>
        <li>План, что исправить в первую очередь</li>
      </ul>
      <div class="diagnostic-proof">
        <div>
          <strong>30 мин</strong>
          <span>разбор по экрану</span>
        </div>
        <div>
          <strong>0 ₽</strong>
          <span>без обязательств</span>
        </div>
        <div>
          <strong>1 план</strong>
          <span>что чинить первым</span>
        </div>
      </div>
      <a
        class="button primary diagnostic-offer__button"
        href={leadMagnet.href}
        data-goal={leadMagnet.goalId}
      >
        Оставить заявку на диагностику
      </a>
    </div>
  </div>
</section>
