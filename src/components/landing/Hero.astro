---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section
  class="hero section"
  id="top"
  style={`--hero-office: url("${base}images/title-background.webp");`}
>
  <div class="hero-copy reveal">
    <p class="eyebrow hero-pill"><span></span>30-минутная диагностика</p>
    <h1>
      Сливаете <span>100 000 ₽/мес</span> на рекламу,
      а в кресле пусто?
    </h1>
    <p class="hero-text hero-text-lead">
      За <span>30</span> минут покажу, где утекают деньги — и как получать
      <span>30–50</span> платёжеспособных пациентов в месяц на имплантацию
      по цене до <span>1 500 ₽</span> за запись
    </p>
    <p class="hero-text">
      Без новых тестов, без слива ещё одного бюджета на «обучение алгоритма»
      и без вашего личного участия в настройках.
    </p>
    <div class="hero-actions">
      <a
        class="button primary"
        href="#diagnostic-request"
        data-goal="paid_tariff_full"
      >
        Получить бесплатную диагностику →
      </a>
    </div>
    <p class="hero-note">Без обязательств · Отвечу за 10 минут</p>
  </div>
  <div class="hero-card human-hero-card reveal delay-1" aria-label="Ростислав Загребин, маркетолог для стоматологий">
    <img
      class="hero-person"
      src={`${base}images/title-person.webp`}
      alt="Ростислав Загребин"
      loading="eager"
      decoding="async"
    />
    <div class="hero-level-card">
      <strong>Ростислав Загребин</strong>
      <p>Маркетолог для стоматологий</p>
    </div>
  </div>
</section>
