---
import { getImage } from "astro:assets";
import rostikTitleRaw from "@/assets/rostik-title.png";
import rostikMobileRaw from "@/assets/rostik-mobile-portrait.png";

// Десктоп — полный landscape-кадр
const bgDesktop = await getImage({ src: rostikTitleRaw, format: "webp", quality: 82, width: 1800 });
// Мобилка — портретный кроп 620×1086 (Ростислав по центру, виден весь офис)
const bgMobile = await getImage({ src: rostikMobileRaw, format: "webp", quality: 82, width: 700 });
---

<section
  class="hero section hero--fullbleed"
  id="top"
  style={`--hero-bg-desktop: url("${bgDesktop.src}"); --hero-bg-mobile: url("${bgMobile.src}");`}
>
  <div class="hero-copy reveal">
    <p class="eyebrow hero-pill"><span></span>30-минутная диагностика</p>
    <h1>
      Сливаете <span>до 100 000 ₽/мес</span> на рекламу своей стоматологии,
      а в кресле пусто?
    </h1>
    <p class="hero-text hero-text-lead">
      За <span>30</span> минут покажу, где утекают деньги — и как получать
      <span>30–50</span> платёжеспособных пациентов в месяц на имплантацию
      по цене до <span>1 500 ₽</span> за запись
    </p>
    <div class="hero-actions">
      <a
        class="button primary"
        href="#diagnostic-request"
        data-goal="paid_tariff_full"
      >
        Получить бесплатную диагностику
      </a>
    </div>
  </div>

</section>
