---
import { product } from '@/content/site';
---

<section class="product-promise" aria-labelledby="product-promise-heading">
  <div class="container product-promise__inner">
    <div class="product-promise__lead">
      <p>{product.promise.eyebrow}</p>
      <h2 id="product-promise-heading">{product.promise.heading}</h2>
    </div>

    <div class="product-promise__body">
      <p>{product.promise.body}</p>
      <div class="product-promise__cards">
        {product.promise.cards.map((card) => (
          <article>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .product-promise {
    padding-block: var(--space-section);
    background-color: var(--color-bg);
  }

  .product-promise__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--space-block);
    align-items: start;
  }

  .product-promise__lead p {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: var(--text-small);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-promise h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.05;
  }

  .product-promise__body > p {
    margin: 0 0 2rem;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .product-promise__cards {
    display: grid;
    gap: 1rem;
  }

  .product-promise__cards article {
    min-width: 0;
    padding: var(--space-content);
    border-inline-start: 6px solid var(--color-accent);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-alt);
  }

  .product-promise__cards h3 {
    margin: 0 0 0.45rem;
    color: var(--color-text-strong);
    font-size: var(--text-h3);
  }

  .product-promise__cards p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .product-promise__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
