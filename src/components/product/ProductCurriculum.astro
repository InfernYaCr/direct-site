---
import { product } from '@/content/site';
---

<section class="product-curriculum" aria-labelledby="product-curriculum-heading">
  <div class="container product-curriculum__inner">
    <div class="product-curriculum__lead">
      <h2 id="product-curriculum-heading" class="product-curriculum__heading">{product.curriculum.heading}</h2>
    </div>

    <div class="product-curriculum__modules">
      {product.curriculum.items.map((item) => (
        <article class="product-curriculum__module">
          <span aria-hidden="true">{item.num}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-curriculum {
    padding-block: var(--space-section);
  }

  .product-curriculum__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-block);
    align-items: start;
  }

  .product-curriculum__lead {
    position: sticky;
    top: 2rem;
  }

  .product-curriculum__heading {
    max-width: 10ch;
    margin: 0;
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .product-curriculum__modules {
    display: grid;
    gap: 1rem;
  }

  .product-curriculum__module {
    display: grid;
    grid-template-columns: minmax(4rem, 0.22fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .product-curriculum__module:nth-child(even) {
    background-color: var(--color-bg-alt);
  }

  .product-curriculum__module span {
    color: var(--color-accent);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 0.85;
  }

  .product-curriculum__module h3 {
    margin: 0 0 0.5rem;
    color: var(--color-text-strong);
    font-size: var(--text-h3);
  }

  .product-curriculum__module p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .product-curriculum__inner {
      grid-template-columns: 1fr;
    }

    .product-curriculum__lead {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .product-curriculum__module {
      grid-template-columns: 1fr;
    }
  }
</style>
