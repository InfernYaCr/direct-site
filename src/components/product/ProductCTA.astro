---
import { product } from '@/content/site';
import Button from '@/components/ui/Button.astro';
---

<section id="product-cta" class="product-cta" aria-labelledby="product-cta-heading">
  <div class="container product-cta__inner">
    <div class="product-cta__content">
      <p class="product-cta__eyebrow">{product.cta.eyebrow}</p>
      <h2 id="product-cta-heading">{product.cta.heading}</h2>
      <p>{product.cta.body}</p>
      <Button href={product.cta.href} variant="primary">{product.cta.label}</Button>
    </div>

    <div class="product-cta__stack">
      <aside class="product-cta__bonus">
        <h3>{product.cta.bonusTitle}</h3>
        <p>{product.cta.bonusBody}</p>
      </aside>

      <form class="product-cta__form" aria-label={product.cta.formTitle}>
        <div class="product-cta__form-head">
          <p>{product.cta.formEyebrow}</p>
          <h3>{product.cta.formTitle}</h3>
          <span>{product.cta.formLead}</span>
        </div>
        {product.cta.formFields.map((field, index) => (
          <label class="product-cta__field">
            <span class="product-cta__label">{field}</span>
            {index === product.cta.formFields.length - 1 ? (
              <textarea class="product-cta__input" name={`field-${index + 1}`} rows="4"></textarea>
            ) : (
              <input class="product-cta__input" name={`field-${index + 1}`} type="text" />
            )}
          </label>
        ))}
        <button class="product-cta__submit" type="button">{product.cta.label}</button>
        <p class="product-cta__note">{product.cta.formNote}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .product-cta {
    padding-block: var(--space-section);
    background-color: var(--color-text-strong);
    color: var(--color-bg);
  }

  .product-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: var(--space-block);
    align-items: center;
  }

  .product-cta__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-2);
    font-size: var(--text-small);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-cta h2 {
    max-width: 15ch;
    margin: 0 0 1.25rem;
    color: var(--color-bg);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .product-cta__content p {
    max-width: 58ch;
    margin: 0 0 2rem;
    color: rgba(255, 255, 255, 0.74);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .product-cta__stack {
    display: grid;
    gap: 1rem;
  }

  .product-cta__bonus {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    background-color: rgba(255, 255, 255, 0.07);
  }

  .product-cta__bonus h3 {
    margin: 0 0 0.75rem;
    color: var(--color-accent-2);
    font-size: var(--text-h3);
  }

  .product-cta__bonus p {
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.55;
  }

  .product-cta__form {
    position: relative;
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(235, 65, 0, 0.16), rgba(235, 65, 0, 0) 36%),
      rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
    overflow: hidden;
  }

  .product-cta__form::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    background-color: var(--color-accent);
  }

  .product-cta__form-head {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    margin-block-end: 0.25rem;
  }

  .product-cta__form-head p,
  .product-cta__form-head h3,
  .product-cta__form-head span {
    margin: 0;
  }

  .product-cta__form-head p {
    color: var(--color-accent-2);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-cta__form-head h3 {
    color: var(--color-bg);
    font-size: var(--text-h3);
    line-height: 1.15;
  }

  .product-cta__form-head span {
    color: rgba(255, 255, 255, 0.66);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .product-cta__field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .product-cta__label {
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--text-small);
    font-weight: 800;
  }

  .product-cta__input {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.10);
    color: var(--color-bg);
    font: inherit;
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .product-cta__input {
    min-height: 3.25rem;
    padding: 0.85rem 1rem;
  }

  textarea.product-cta__input {
    min-height: 7.5rem;
    resize: vertical;
  }

  .product-cta__input:focus {
    border-color: var(--color-accent);
    background-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 0 0 3px rgba(235, 65, 0, 0.24);
  }

  .product-cta__submit {
    min-height: 3.5rem;
    margin-block-start: 0.5rem;
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--color-accent);
    color: var(--color-bg);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .product-cta__submit:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .product-cta__note {
    margin: 0;
    color: rgba(255, 255, 255, 0.52);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .product-cta__inner { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-cta__input,
    .product-cta__submit { transition: none; }
    .product-cta__submit:hover { transform: none; }
  }
</style>
