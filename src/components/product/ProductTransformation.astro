---
import { product } from '@/content/site';
---

<section class="product-transformation" aria-labelledby="product-transformation-heading">
  <div class="container">
    <h2 id="product-transformation-heading" class="product-transformation__heading">
      {product.transformation.heading}
    </h2>

    <div class="product-transformation__grid">
      {product.transformation.items.map((item) => (
        <article class="product-transformation__card">
          <h3>{item.label}</h3>
          <div class="product-transformation__compare">
            <div class="product-transformation__before">
              <span>{product.labels.before}</span>
              <p>{item.before}</p>
            </div>
            <div class="product-transformation__after">
              <span>{product.labels.after}</span>
              <p>{item.after}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-transformation {
    padding-block: var(--space-section);
  }

  .product-transformation__heading {
    max-width: 14ch;
    margin: 0 0 var(--space-block);
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .product-transformation__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap);
  }

  .product-transformation__card {
    min-width: 0;
    padding: var(--space-content);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .product-transformation__card h3 {
    margin: 0 0 1rem;
    color: var(--color-text-strong);
    font-size: var(--text-h3);
  }

  .product-transformation__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .product-transformation__before,
  .product-transformation__after {
    min-width: 0;
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .product-transformation__before { background-color: var(--color-bg-alt); }
  .product-transformation__after {
    background-color: var(--color-bg);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .product-transformation span {
    display: block;
    margin-block-end: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-transformation__before span { color: var(--color-text-muted); }
  .product-transformation__after span { color: var(--color-success); }

  .product-transformation p {
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .product-transformation__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .product-transformation__compare { grid-template-columns: 1fr; }
  }
</style>
