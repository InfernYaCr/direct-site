---
import { product } from '@/content/site';
import Button from '@/components/ui/Button.astro';
---

<section class="product-results" aria-labelledby="product-results-heading">
  <div class="container">
    <h2 id="product-results-heading" class="product-results__heading">{product.results.heading}</h2>

    <div class="product-results__grid">
      {product.results.items.map((item, index) => (
        <article class="product-results__card">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <Button href="#product-cta" variant="ghost">{item.cta}</Button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-results {
    padding-block: var(--space-section);
  }

  .product-results__heading {
    max-width: 12ch;
    margin: 0 0 var(--space-block);
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .product-results__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-gap);
  }

  .product-results__card {
    display: flex;
    min-width: 0;
    min-height: 15rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--space-content);
    border-radius: var(--radius-lg);
    background-color: var(--color-text-strong);
    color: var(--color-bg);
  }

  .product-results__card span {
    color: var(--color-accent-2);
    font-size: var(--text-small);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .product-results__card h3 {
    margin: 0;
    color: var(--color-bg);
    font-size: var(--text-h3);
    line-height: 1.2;
  }

  .product-results__card :global(.btn--ghost) {
    align-self: flex-start;
    color: var(--color-bg);
  }

  .product-results__card :global(.btn--ghost:hover) {
    color: var(--color-accent-2);
  }

  @media (max-width: 1024px) {
    .product-results__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .product-results__grid { grid-template-columns: 1fr; }
  }
</style>
