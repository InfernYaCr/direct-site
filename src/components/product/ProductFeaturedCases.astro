---
import { product } from '@/content/site';
import Button from '@/components/ui/Button.astro';
---

<section class="featured-cases" aria-labelledby="featured-cases-heading">
  <div class="container">
    <div class="featured-cases__lead">
      <h2 id="featured-cases-heading" class="featured-cases__heading">{product.featuredCases.heading}</h2>
      <p>{product.featuredCases.intro}</p>
    </div>

    <div class="featured-cases__grid">
      {product.featuredCases.items.map((item) => (
        <article class="featured-cases__card">
          <div class="featured-cases__top">
            <p class="featured-cases__niche">{item.niche}</p>
            <strong>{item.result}</strong>
          </div>
          <div class="featured-cases__compare">
            <div>
              <span>{product.labels.before}</span>
              <p>{item.before}</p>
            </div>
            <div>
              <span>{product.labels.after}</span>
              <p>{item.after}</p>
            </div>
          </div>
          <blockquote>{item.quote}</blockquote>
          <Button href="#product-cta" variant="ghost">{item.cta}</Button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured-cases {
    padding-block: var(--space-section);
  }

  .featured-cases__lead {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-block);
    align-items: end;
    margin-block-end: var(--space-block);
  }

  .featured-cases__heading {
    max-width: 14ch;
    margin: 0;
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .featured-cases__lead > p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .featured-cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap);
  }

  .featured-cases__card {
    min-width: 0;
    padding: var(--space-content);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .featured-cases__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .featured-cases__niche {
    margin: 0;
    color: var(--color-accent);
    font-weight: 800;
  }

  .featured-cases__top strong {
    max-width: 12ch;
    color: var(--color-text-strong);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-align: right;
  }

  .featured-cases__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .featured-cases__compare div {
    min-width: 0;
    padding: 1rem;
    border-radius: var(--radius-md);
    background-color: var(--color-bg-alt);
  }

  .featured-cases__compare div:last-child {
    background-color: var(--color-bg);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .featured-cases__compare span {
    display: block;
    margin-block-end: 0.45rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-cases__compare div:last-child span { color: var(--color-success); }

  .featured-cases__compare p,
  .featured-cases__card blockquote {
    margin: 0;
    line-height: 1.55;
  }

  .featured-cases__card blockquote {
    margin-block: 1.25rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .featured-cases__lead,
    .featured-cases__grid,
    .featured-cases__compare {
      grid-template-columns: 1fr;
    }

    .featured-cases__top {
      display: grid;
    }

    .featured-cases__top strong {
      max-width: none;
      text-align: left;
    }
  }
</style>
