---
import { product } from '@/content/site';
---

<section class="product-pains" aria-labelledby="product-pains-heading">
  <div class="container product-pains__inner">
    <h2 id="product-pains-heading" class="product-pains__heading">{product.pains.heading}</h2>

    <div class="product-pains__list">
      {product.pains.items.map((item) => (
        <article class="product-pains__item">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="currentColor" />
          </svg>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-pains {
    padding-block: var(--space-section);
    background-color: var(--color-bg);
  }

  .product-pains__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-block);
    align-items: start;
  }

  .product-pains__heading {
    position: sticky;
    top: 2rem;
    margin: 0;
    color: var(--color-text-strong);
    font-size: var(--text-h1);
    line-height: 1.08;
  }

  .product-pains__list {
    display: grid;
    gap: 1rem;
  }

  .product-pains__item {
    display: flex;
    gap: 1rem;
    min-width: 0;
    padding-block: 1rem;
    border-block-end: 1px solid rgba(0, 0, 0, 0.1);
  }

  .product-pains__item svg {
    flex: 0 0 auto;
    margin-block-start: 0.2rem;
    color: var(--color-text-strong);
  }

  .product-pains__item h3 {
    margin: 0 0 0.35rem;
    color: var(--color-text-strong);
    font-size: var(--text-base);
    font-weight: 800;
  }

  .product-pains__item p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .product-pains__inner { grid-template-columns: 1fr; }
    .product-pains__heading { position: static; }
  }
</style>
