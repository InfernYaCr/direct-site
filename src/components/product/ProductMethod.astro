---
import { product } from '@/content/site';
---

<section class="product-method" aria-labelledby="product-method-heading">
  <div class="container product-method__inner">
    <div class="product-method__panel">
      <h2 id="product-method-heading">{product.method.heading}</h2>
      <p>{product.method.body}</p>
    </div>

    <div class="product-method__steps">
      {product.method.highlights.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-method {
    padding-block: var(--space-section);
    background-color: var(--color-text-strong);
    color: var(--color-bg);
  }

  .product-method__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-block);
    align-items: stretch;
  }

  .product-method__panel {
    min-width: 0;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    background-color: rgba(255, 255, 255, 0.07);
  }

  .product-method h2 {
    max-width: 13ch;
    margin: 0 0 1.25rem;
    color: var(--color-bg);
    font-size: var(--text-h1);
    line-height: 1.05;
  }

  .product-method__panel p {
    max-width: 56ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .product-method__steps {
    display: grid;
    gap: 1rem;
  }

  .product-method__steps article {
    min-width: 0;
    padding: var(--space-content);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .product-method__steps span {
    display: block;
    margin-block-end: 0.75rem;
    color: var(--color-accent);
    font-size: var(--text-h3);
    font-weight: 800;
  }

  .product-method__steps h3 {
    margin: 0 0 0.45rem;
    color: var(--color-text-strong);
    font-size: var(--text-h3);
  }

  .product-method__steps p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .product-method__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
