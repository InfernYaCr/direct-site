---
import { site } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-intro">
      <a class="brand footer-brand" href={base}>
        <span class="brand-mark" aria-hidden="true">
          <span>УН</span>
          <i></i>
        </span>
        <span class="brand-word">
          <strong>Умный<span>Навигатор</span></strong>
          <em>для стоматологий</em>
        </span>
      </a>
      <p>Диагностика рекламы ВК и Яндекс.Директ для стоматологических клиник.</p>
      <a class="footer-cta" href={`${base}#diagnostic-request`}>Получить диагностику 0 ₽ →</a>
    </div>
    <nav class="footer-links" aria-label="Ссылки в подвале">
      <span class="footer-links__title">Навигация</span>
      <a href={`${base}privacy/`}>Политика</a>
      <a href={`${base}offer/`}>Оферта</a>
      <a href={`${base}cookies/`}>Cookies</a>
      <a href={site.vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="footer-copy">© {year} «Умный Навигатор»</p>
    <a
      class="dev-credit"
      href="https://neon-dev.ru/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Сайт разработан Neon Dev"
    >
      <span class="dev-credit-dot" aria-hidden="true"></span>
      <span>Разработано в <strong>Neon Dev</strong></span>
      <em>online</em>
    </a>
  </div>
</footer>
