---
import { site } from "@/data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div>
    <a class="brand footer-brand" href={base}>
      <span class="brand-mark" aria-hidden="true">
        <span>УН</span>
        <i></i>
      </span>
      <span class="brand-word">
        <strong>Умный<span>Навигатор</span></strong>
        <em>для стоматологий</em>
      </span>
    </a>
    <p>Диагностика рекламы ВК и Яндекс.Директ для стоматологических клиник.</p>
  </div>
  <div class="footer-links">
    <a href={`${base}contacts/`}>Контакты</a>
    <a href={`${base}privacy/`}>Политика</a>
    <a href={`${base}offer/`}>Оферта</a>
    <a href={`${base}refund/`}>Возврат</a>
    <a href={`${base}cookies/`}>Cookies</a>
    <a href={site.telegramUrl}>Telegram</a>
    <a href={site.vkUrl}>VK</a>
    <a href={`mailto:${site.supportEmail}`}>Поддержка</a>
  </div>
  <a
    class="dev-credit"
    href="https://neon-dev.ru/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Сайт разработан Neon Dev"
  >
    <span class="dev-credit-dot" aria-hidden="true"></span>
    <span>Разработано в <strong>Neon Dev</strong></span>
    <em>online</em>
  </a>
</footer>
