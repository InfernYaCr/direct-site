# Скопируйте этот файл в .env.local и заполните значения
# .env.local добавлен в .gitignore — НЕ коммитится в репозиторий

# FTP-доступ для deploy.sh
FTP_HOST=ftp.rosa-zagrebin.ru
FTP_USER=yourkedm_direct
FTP_PASS=your_password_here
FTP_DIR=/direkt/public_html/

# URL сайта для сборки
SITE_URL=https://rosa-zagrebin.ru
BASE_PATH=/
